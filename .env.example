# Tenant owner: deploys contracts, owns maps, grants and revokes access.
T3N_API_KEY=

# Oriel certifier agent: may run qualifications, but cannot revoke them.
ORIEL_AGENT_KEY=

# Demo target agent: may call the protected function after qualification.
TARGET_AGENT_KEY=

# The target service signs each response with the same Ethereum key as TARGET_AGENT_KEY.
ORIEL_TARGET_ATTESTATION_KEY=

# Runtime role for targets/src/server.ts. Use agent for the upstream target or
# gateway for the separate observer service (recommended for deployment).
ORIEL_TARGET_ROLE=gateway
ORIEL_UPSTREAM_TARGET_URL=https://replace-with-target-agent.example/hardened/v2/run
ORIEL_TARGET_DID=did:t3n:replace_with_target_address

# A separate probe gateway receipts the returned evidence; production adapters
# should build action traces from trusted tool/egress events. Never reuse the target key.
ORIEL_OBSERVER_ATTESTATION_KEY=

T3N_ENV=testnet
ORIEL_TENANT_DID=did:t3n:replace_after_registration
# This is the public gateway URL supplied to the T3N contract, not the private upstream.
ORIEL_TARGET_URL=https://replace-with-public-target.example/hardened/v2/run
ORIEL_TARGET_VERSION=sha256:fulfillment-v2-hardened
ORIEL_TEST_PACK_ID=support-data-boundary
